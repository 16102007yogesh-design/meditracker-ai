{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representing a patient or caregiver",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching auth UID" },
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["patient", "caregiver"], "description": "Role in the system" },
        "avatar": { "type": "string", "description": "URL or avatar placeholder" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "Prescribed medicine details shared between patient and caregiver",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique medicine identifier" },
        "name": { "type": "string", "description": "Name of the medication" },
        "dosage": { "type": "string", "description": "Dosage amount e.g. 500mg" },
        "frequency": { "type": "string", "description": "Frequency e.g. Twice daily" },
        "instructions": { "type": "string", "description": "Instructions e.g. With food" },
        "prescribedBy": { "type": "string", "description": "Doctor or caregiver name/UID" },
        "prescribedTo": { "type": "string", "description": "Patient UID or name" },
        "startDate": { "type": "string", "description": "Start date ISO" },
        "endDate": { "type": "string", "description": "End date ISO" },
        "status": { "type": "string", "enum": ["Active", "Completed", "Discontinued"], "description": "Medicine status" },
        "remainingPills": { "type": "number", "description": "Current pills count" },
        "totalPills": { "type": "number", "description": "Total pill count" },
        "color": { "type": "string", "description": "Visual tag color" },
        "takenToday": { "type": "boolean", "description": "Whether taken today" },
        "takenCount": { "type": "number", "description": "Number of doses taken today" },
        "lastTakenTime": { "type": "string", "description": "Timestamp of last taken dose" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "name", "dosage", "status"]
    },
    "AdherenceLog": {
      "title": "AdherenceLog",
      "description": "Logged medication events for adherence and charting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log record ID" },
        "medicineId": { "type": "string", "description": "Associated medicine ID" },
        "medicineName": { "type": "string", "description": "Name of medication" },
        "patientId": { "type": "string", "description": "Patient UID" },
        "timestamp": { "type": "string", "description": "ISO timestamp of event" },
        "status": { "type": "string", "enum": ["taken", "missed", "skipped"], "description": "Adherence status" },
        "notes": { "type": "string", "description": "Optional notes or symptom check" }
      },
      "required": ["id", "medicineId", "medicineName", "patientId", "timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection indexed by auth UID"
    },
    "/medicines/{medicineId}": {
      "schema": { "$ref": "#/entities/Medicine" },
      "description": "Prescriptions and tablets managed by caregivers and tracked by patients"
    },
    "/adherence_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdherenceLog" },
      "description": "Medication adherence audit trail and history logs"
    }
  }
}
